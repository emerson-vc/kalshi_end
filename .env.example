# Which exchange: mock (offline), demo, or prod
KALSHI_ENV=mock

# Production keys (never commit .env)
KALSHI_PROD_API_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=~/.kalshi/prod.pem

# Demo keys (optional)
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=~/.kalshi/demo.pem

# 1 = Real execution can never be enabled
COMBO_EDGE_FORBID_LIVE=0

# Passcode for `combo-edge --lan` (phone access on your home network)
COMBO_EDGE_LAN_PASSCODE=
